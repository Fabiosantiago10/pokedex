# Copie este arquivo para .env e preencha.

# Chave da API do Claude (console.anthropic.com)
ANTHROPIC_API_KEY=

# Token do GitHub com permissão "Contents: Read and write" só no repositório da Pokédex
# (GitHub > Settings > Developer settings > Fine-grained tokens)
GITHUB_TOKEN=
GITHUB_REPO=Fabiosantiago10/pokedex
GITHUB_BRANCH=main
GITHUB_ARQUIVO=pokemons.json

# Modelos: um barato para reconhecer a tela, um mais forte para ler os números e avaliar
MODELO_CLASSIFICAR=claude-haiku-5-5
MODELO_LER=claude-sonnet-5-5

# Qual monitor o PokeMMO está (rode "npm run telas" para ver a lista). Vazio = monitor principal
MONITOR=

# A cada quantos ms ele olha a tela
INTERVALO_MS=1500
# Quanto tempo a tela precisa ficar parada para ele olhar com atenção (menus ficam parados, batalha não)
TELA_PARADA_MS=1200
# Depois de quantos ms sem ver o resumo ele fecha o cadastro do Pokémon
FINALIZAR_MS=25000

# true = salva só no PC (agente/dados/pokemons.json), sem mandar para o GitHub
SO_LOCAL=false
